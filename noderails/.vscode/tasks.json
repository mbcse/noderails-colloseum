{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "kill-dev-ports",
      "type": "shell",
      "command": "bash scripts/kill-dev-ports.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "group": "noderails-dev",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "build-prod",
      "type": "shell",
      "command": "bash scripts/build-prod.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "group": "noderails-dev"
      },
      "problemMatcher": []
    },
    {
      "label": "start-apps",
      "dependsOn": [
        "server",
        "start-dashboard",
        "start-payment-ui",
        "start-landing",
        "start-admin",
        "contracts-ops-ui"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "echo": false,
        "close": true
      }
    },
    {
      "label": "Dev: apps",
      "dependsOn": ["server", "dashboard", "payment-ui", "landing", "admin", "contracts-ops-ui"],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "echo": false,
        "close": true
      }
    },
    {
      "label": "Dev: all",
      "dependsOn": ["kill-dev-ports", "Dev: apps"],
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "start-server",
      "type": "shell",
      "command": "bash scripts/with-doppler.sh pnpm --filter @noderails/server start",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "noderails-dev",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "."
        }
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "group": "noderails-dev"
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
